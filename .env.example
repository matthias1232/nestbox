# Copy to .env for local development. Never commit a real .env.
NESTBOX_SECRET_KEY=change-me-to-a-long-random-string
NESTBOX_ALLOWED_HOSTS=localhost,127.0.0.1
NESTBOX_DEBUG=1

# First admin created by `manage.py bootstrap`
NESTBOX_BOOTSTRAP_ADMIN_EMAIL=you@example.com
NESTBOX_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Runtime and gateway
NESTBOX_DOCKER_SOCKET=unix:///var/run/docker.sock
NESTBOX_OPENSHELL_ENDPOINT=127.0.0.1:50051
NESTBOX_OPENSHELL_ADAPTER=auto

# PostgreSQL (production only; development uses SQLite)
NESTBOX_DB_NAME=nestbox
NESTBOX_DB_USER=nestbox
NESTBOX_DB_PASSWORD=
NESTBOX_DB_HOST=127.0.0.1
NESTBOX_DB_PORT=5432
