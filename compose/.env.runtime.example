# Copy to /etc/nestbox/runtime.env (or compose/.env.runtime) and fill only the
# deployment-wide, non-provider values.  Provider credentials stay in a local
# provider file consumed by scripts/nemoclaw/onboard.sh.
NESTBOX_UI_PORT=443
OPENSHELL_PORT=8080
OPENSHELL_GATEWAY_IMAGE=ghcr.io/nvidia/openshell/gateway:latest
NESTBOX_OPENSHELL_ENDPOINT=http://gateway:8080

# Compose profile: runtime starts the official OpenShell Docker gateway.
COMPOSE_PROFILES=runtime
