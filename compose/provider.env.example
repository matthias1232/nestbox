# Never commit a populated copy of this file.
# Select exactly one provider for the first NemoClaw onboarding run.

# Hosted providers
# NEMOCLAW_PROVIDER=openai
# OPENAI_API_KEY=
# NEMOCLAW_MODEL=

# NEMOCLAW_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# NEMOCLAW_MODEL=

# NEMOCLAW_PROVIDER=gemini
# GEMINI_API_KEY=
# NEMOCLAW_MODEL=

# Existing OpenAI-compatible local server (vLLM, NIM, llama.cpp, etc.).
# NEMOCLAW_PROVIDER=custom
# NEMOCLAW_ENDPOINT_URL=http://host.openshell.internal:8000/v1
# COMPATIBLE_API_KEY=
# NEMOCLAW_MODEL=

# Existing vLLM endpoint chosen by NemoClaw.
# NEMOCLAW_PROVIDER=vllm
# NEMOCLAW_MODEL=

# Existing Ollama endpoint.
# NEMOCLAW_PROVIDER=ollama
# NEMOCLAW_MODEL=

NEMOCLAW_AGENT=openclaw
NEMOCLAW_SANDBOX_NAME=nestbox-agent
NEMOCLAW_WEB_SEARCH_PROVIDER=none
