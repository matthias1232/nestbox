[Unit]
Description=Nestbox first-boot configuration
Documentation=https://nestbox.mmbits.com
After=network-online.target docker.service
Wants=network-online.target
ConditionPathExists=!/var/lib/nestbox/.firstboot-done

[Service]
Type=oneshot
ExecStart=/usr/local/lib/nestbox/firstboot.sh
RemainAfterExit=yes
StandardOutput=journal
StandardError=journal
# A fresh appliance can need to pull both the controller and OpenShell gateway
# images before it can present the first-login experience.
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
