{
  "name": "Nestbox",
  "version": "1.0.0",
  "mode": "dark-first",
  "color": {
    "base": "#0B1020",
    "surface": "#131A2B",
    "surfaceAlt": "#1A2338",
    "border": "#253049",
    "foreground": "#E8EDF7",
    "muted": "#8B97B3",
    "primary": "#22D3EE",
    "secondary": "#8B5CF6",
    "accent": "#F59E0B",
    "success": "#34D399",
    "warning": "#FBBF24",
    "danger": "#F87171"
  },
  "light": {
    "base": "#F6F8FC",
    "surface": "#FFFFFF",
    "surfaceAlt": "#EEF2F9",
    "border": "#DBE3F0",
    "foreground": "#0F172A",
    "muted": "#5A6784"
  },
  "radius": { "sm": 8, "md": 10, "lg": 12, "xl": 16 },
  "typography": {
    "sans": "Inter",
    "mono": "JetBrains Mono",
    "scale": { "xs": 11, "sm": 12, "base": 14, "lg": 16, "xl": 22, "display": 32 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48 },
  "constraints": {
    "accentUsage": "at most once per composition",
    "borderWidth": 1,
    "shadow": "none beyond one blur step",
    "noTextInGeneratedImages": true,
    "noThirdPartyLogos": true
  }
}
